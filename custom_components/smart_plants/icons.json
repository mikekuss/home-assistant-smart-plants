{
  "entity": {
    "binary_sensor": {
      "all_plants": {
        "default": "mdi:flower-outline"
      },
      "care_task_fertilize": {
        "default": "mdi:flask-outline"
      },
      "care_task_prune": {
        "default": "mdi:content-cut"
      },
      "care_task_repot": {
        "default": "mdi:pot-mix-outline"
      },
      "care_task_pests": {
        "default": "mdi:bug-outline"
      },
      "care_task_winter_protection": {
        "default": "mdi:snowflake"
      },
      "care_task_custom": {
        "default": "mdi:checkbox-marked-circle-outline"
      },
      "care_due": {
        "default": "mdi:calendar-check-outline"
      }
    },
    "sensor": {
      "care_task_fertilize_next": {
        "default": "mdi:flask-outline"
      },
      "care_task_prune_next": {
        "default": "mdi:content-cut"
      },
      "care_task_repot_next": {
        "default": "mdi:pot-mix-outline"
      },
      "care_task_pests_next": {
        "default": "mdi:bug-outline"
      },
      "care_task_winter_protection_next": {
        "default": "mdi:snowflake"
      },
      "care_task_custom_next": {
        "default": "mdi:checkbox-marked-circle-outline"
      }
    }
  },
  "services": {
    "log_care": {
      "service": "mdi:watering-can"
    },
    "skip_care_task": {
      "service": "mdi:debug-step-over"
    },
    "snooze": {
      "service": "mdi:bell-sleep-outline"
    },
    "unsnooze": {
      "service": "mdi:bell-ring-outline"
    },
    "get_report": {
      "service": "mdi:clipboard-text"
    }
  },
  "triggers": {
    "needs_water": {
      "trigger": "mdi:water-alert"
    },
    "problem_started": {
      "trigger": "mdi:alert-circle"
    },
    "problem_cleared": {
      "trigger": "mdi:check-circle"
    },
    "care_task_due": {
      "trigger": "mdi:calendar-check"
    }
  },
  "conditions": {
    "needs_water": {
      "condition": "mdi:water-alert"
    },
    "has_problem": {
      "condition": "mdi:alert-circle"
    },
    "care_task_due": {
      "condition": "mdi:calendar-check"
    },
    "is_not_snoozed": {
      "condition": "mdi:bell"
    },
    "needs_attention": {
      "condition": "mdi:sprout"
    }
  }
}
