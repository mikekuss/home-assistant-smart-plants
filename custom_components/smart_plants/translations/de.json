  "services": {
    "log_care": {
      "name": "Pflege eintragen",
      "description": "Trägt Pflege für Smart-Plants-Pflanzen ein oder markiert Pflegeaufgaben als erledigt. Ein eingetragenes Gießen hält Braucht Wasser außerdem 24 Stunden lang aus.",
      "fields": {
        "kind": {
          "name": "Pflegeart",
          "description": "Was gemacht wurde. Erforderlich, wenn Sie Pflanzen auswählen. Bei einer Pflegeaufgabe kann das Feld leer bleiben; wenn gesetzt, muss es zur Aufgabe passen."
        },
        "occurred_at": {
          "name": "Zeitpunkt",
          "description": "Wann die Pflege stattfand. Standard ist jetzt; der Zeitpunkt darf nicht in der Zukunft liegen."
        },
        "note": {
          "name": "Notiz",
          "description": "Optionale Notiz mit bis zu 500 Zeichen. Für die Pflegeart Notiz erforderlich."
        }
      }
    },
    "skip_care_task": {
      "name": "Pflegeaufgabe überspringen",
      "description": "Überspringt die aktuelle Fälligkeit von Smart-Plants-Pflegeaufgaben. Die Aufgabe wird zum nächsten geplanten Termin wieder fällig. Pflegeaufgaben, die sich nach einem Messwert richten, können nicht übersprungen werden."
    },
    "snooze": {
      "name": "Hinweise stummschalten",
      "description": "Schaltet die Hinweise von Smart-Plants-Pflanzen stumm, zum Beispiel während eines Urlaubs. Die Entitäten behalten ihren echten Zustand; ihr Attribut Stummgeschaltet wird aktiv, damit Automationen still bleiben können. Erneutes Stummschalten ersetzt das Ende. Die Stummschaltung endet von selbst.",
      "fields": {
        "duration": {
          "name": "Dauer",
          "description": "Wie lange ab jetzt stummgeschaltet wird. Entweder dies oder Bis angeben, höchstens 366 Tage."
        },
        "until": {
          "name": "Bis",
          "description": "Wann die Stummschaltung endet. Entweder dies oder Dauer angeben, höchstens 366 Tage im Voraus."
        }
      }
    },
    "unsnooze": {
      "name": "Hinweise fortsetzen",
      "description": "Beendet die Stummschaltung der Hinweise von Smart-Plants-Pflanzen sofort."
    }
  },
