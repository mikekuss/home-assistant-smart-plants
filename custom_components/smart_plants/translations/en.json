    "no_plant_target": {
      "message": "Choose at least one plant."
    },
    "plant_disabled_snooze": {
      "message": "{plant} is disabled. Enable it before snoozing its alerts."
    },
    "snooze_period_required": {
      "message": "Set either a duration or an end time, not both."
