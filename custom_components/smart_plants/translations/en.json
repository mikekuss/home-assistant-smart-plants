  "selector": {
    "care_kind": {
      "options": {
        "watering": "Watering",
        "fertilizing": "Fertilizing",
        "pruning": "Pruning",
        "repotting": "Repotting",
        "note": "Note",
        "task": "Other task"
      }
    }
