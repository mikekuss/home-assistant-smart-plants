  "issues": {
    "moisture_source_missing": {
      "title": "Smart Plants: assigned source missing",
      "fix_flow": {
        "step": {
          "source": {
            "title": "Repair missing plant source",
            "description": "The {role} source {entity_id} assigned to {plant_name} is missing. Choose a replacement, or leave the field empty to remove the assignment.",
            "data": {
              "replacement_entity_id": "Replacement entity"
            }
          }
        },
        "error": {
          "invalid_source": "The replacement is unavailable, incompatible, or no longer matches the entity registry. Choose another entity."
        },
        "abort": {
          "integration_not_loaded": "Smart Plants is not loaded.",
          "invalid_issue": "This repair does not contain a valid source assignment.",
          "issue_resolved": "The source assignment has already been repaired or removed."
        }
      }
    }
