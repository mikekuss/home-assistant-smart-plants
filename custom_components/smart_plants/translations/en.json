  "services": {
    "log_care": {
      "name": "Log care",
      "description": "Logs care for Smart Plants plants or marks care tasks as done. Logging watering also keeps Needs water off for 24 hours.",
      "fields": {
        "kind": {
          "name": "Care type",
          "description": "What was done. Required when you target plants. When you target a care task, it can be left empty; if set, it must match the task."
        },
        "occurred_at": {
          "name": "Time",
          "description": "When the care happened. Defaults to now and cannot be in the future."
        },
        "note": {
          "name": "Note",
          "description": "Optional note, up to 500 characters. Required for the Note care type."
        }
      }
    },
    "skip_care_task": {
      "name": "Skip care task",
      "description": "Skips the current occurrence of Smart Plants care tasks. The task becomes due again on its next scheduled date. Care tasks that follow a sensor reading cannot be skipped."
    },
    "snooze": {
      "name": "Snooze alerts",
      "description": "Snoozes the alerts of Smart Plants plants, for example during a vacation. Entities keep their real states; their Snoozed attribute turns on so automations can stay quiet. Snoozing again replaces the end. The snooze ends by itself.",
      "fields": {
        "duration": {
          "name": "Duration",
          "description": "How long to snooze, counted from now. Set either this or Until, at most 366 days."
        },
        "until": {
          "name": "Until",
          "description": "When the snooze ends. Set either this or Duration, at most 366 days ahead."
        }
      }
    },
    "unsnooze": {
      "name": "Resume alerts",
      "description": "Ends the alert snooze of Smart Plants plants now."
    }
  },
